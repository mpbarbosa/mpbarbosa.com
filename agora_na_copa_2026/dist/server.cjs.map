  "419100": {
    "fifaId": "419100",
    "teamCode": "URU",
    "name": "Maxi Araujo",
    "fullName": "Maxi Araujo",
    "number": 20,
    "position": "MF",
    "club": "Sporting CP",
    "pictureUrl": "https://digitalhub.fifa.com/transform/f1a7af03-ada1-4642-927c-5fe06844c89c/ARAUJO-Maxi_419100",
    "socials": {
