  "430609": {
    "fifaId": "430609",
    "teamCode": "BRA",
    "name": "Matheus Cunha",
    "fullName": "Matheus Cunha",
    "number": 9,
    "position": "FW",
    "club": "Wolverhampton",
    "pictureUrl": "https://digitalhub.fifa.com/transform/9189da72-e1b5-4e7b-800d-7eeca119f08c/MATHEUS-CUNHA_430609",
