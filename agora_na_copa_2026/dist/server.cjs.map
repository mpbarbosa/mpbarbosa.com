  "336022": {
    "fifaId": "336022",
    "teamCode": "ENG",
    "name": "Pickford",
    "fullName": "Jordan Pickford",
    "number": 1,
    "position": "GK",
    "club": "Everton",
    "pictureUrl": "https://digitalhub.fifa.com/transform/5f9b3bbf-edb5-4956-bce7-2d0a8e77f6ab/PICKFORD-Jordan_336022",
    "dateOfBirth": "1994-03-07",
    "height": 185,
    "socials": {
      "instagram": "jpickford1",
